# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# OpenPhone Configuration
OPENPHONE_API_KEY=your_openphone_api_key_here
OPENPHONE_PHONE_NUMBER=your_openphone_number_here

# Sona Voice AI Configuration
SONA_API_KEY=your_sona_api_key_here
SONA_ENDPOINT=https://api.sona.ai

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Business Contact Information
BUSINESS_EMAIL=owner@yourshop.com
BUSINESS_SMS=+1234567890

# Notification Settings
NOTIFY_NEW_MESSAGES=true
NOTIFY_QUOTE_REQUESTS=true
NOTIFY_APPOINTMENTS=true

# Business Settings
BUSINESS_NAME=Pink Chicken Speed Shop
LABOR_RATE=80
DND_ENABLED=true

# Server Configuration
NODE_ENV=production
PORT=10000

# Frontend URL (for CORS and documentation)
FRONTEND_URL=https://shopsenseai.netlify.app